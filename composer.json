{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "simplysmart/mainboard",
    "type": "library",
    "description": "Modular mainboard for simplysmart applications: connect modules, management workspaces, and beyond.",
    "keywords": [
        "simplysmart",
        "mainboard",
        "modular",
        "modules"
    ],
    "homepage": "https://github.com/marcinulezalka/mainboard",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcin Ulezalka",
            "email": "marcin.ulezalka@simplysmart.pl",
            "role": "Founder"
        }
    ],
    "support": {
        "issues": "https://github.com/marcinulezalka/mainboard/issues",
        "source": "https://github.com/marcinulezalka/mainboard"
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "Simplysmart\\Mainboard\\": "src/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
